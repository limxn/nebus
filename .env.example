# PostgreSQL (docker-compose maps 5432 -> 55432 on host to avoid clashes)
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=nebus
POSTGRES_PASSWORD=nebus
POSTGRES_DB=nebus
DATABASE_URL=postgresql+asyncpg://nebus:nebus@localhost:55432/nebus

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# API
API_KEY=local-secret-key-change-me
API_HOST=0.0.0.0
API_PORT=8000

# Outbox relay
OUTBOX_POLL_INTERVAL_SECONDS=2

# Consumer retry
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1

# Webhook retry
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=5
